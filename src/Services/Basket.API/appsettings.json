{
  "ConnectionStrings": {
    "BasketDb": "Data Source=basket.db"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "SecretKey": "SecretKeyOfDoomThatMustBeAMinimumNumberOfBytes"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Network" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "Basket.API"
    }
  },
  "AllowedHosts": "*"
}
