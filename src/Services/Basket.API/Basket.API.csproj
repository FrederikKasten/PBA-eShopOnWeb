<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Namespace er "BasketApi" (ikke "Basket.API"), fordi klassen hedder Basket.
      Med et namespace der hedder Basket kan C# ikke se forskel på namespacet Basket
      og klassen Basket, og så får man fejlen CS0118.
    -->
    <RootNamespace>BasketApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="Ardalis.Result" />
    <PackageReference Include="Ardalis.Specification" />
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Til "dotnet ef migrations add" (Data/Migrations). Kommer ikke med i det byggede program. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- HTTP-endpoints kræver et JWT fra PublicApi (samme pakke og version som PublicApi og Web). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- RabbitMQ via MassTransit (samme pakke og version som Ordering.API og Web). -->
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- Logning til konsol + Logstash (samme pakker og versioner som Web og PublicApi, se elk/LOGGING.md). -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Network" />
  </ItemGroup>

  <ItemGroup>
    <!-- Beskederne (Canonical Data Model), som Web og de andre services også bruger. -->
    <ProjectReference Include="../../Contracts/Contracts.csproj" />
  </ItemGroup>

</Project>
