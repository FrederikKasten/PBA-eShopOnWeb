# One version for all three components - they must always match.
STACK_VERSION=9.1.5

# Heap size for Elasticsearch. 1g is fine for local dev; raise for real workloads.
ES_HEAP=1g

# Tag for the eShop images pushed to GHCR (e.g. latest, v1.0, a commit SHA)
IMAGE_TAG=latest

# Host ports
# SQL Server container, reachable from the host as localhost,14333
# (1433/1434 are taken by the local SQL Server installation).
SQL_PORT=14333
ES_PORT=9200
KIBANA_PORT=5601
LOGSTASH_TCP_PORT=5000
LOGSTASH_BEATS_PORT=5044
